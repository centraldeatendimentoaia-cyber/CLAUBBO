{
  "name": "escritorio-v2",
  "version": "1.0.3",
  "private": true,
  "description": "Escritório virtual animado que mostra, em tempo real, o que seus agentes do Claude Code estão fazendo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmottajr/habblaud.git"
  },
  "homepage": "https://github.com/marmottajr/habblaud#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node server/build-shared.mjs && vite build --config vite.config.ts",
    "start": "node server/bridge.mjs",
    "dev:client": "vite --config vite.config.ts",
    "check": "node server/build-shared.mjs && node server/test/core-check.mjs && node server/test/transcript-check.mjs && node server/test/cli-mode-check.mjs && node server/test/retorno-check.mjs && vitest run",
    "test": "vitest run",
    "visual": "node server/test/visual-check.mjs",
    "mod:install": "node scripts/mod.mjs install",
    "mod:status": "node scripts/mod.mjs status",
    "mod:uninstall": "node scripts/mod.mjs uninstall",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
